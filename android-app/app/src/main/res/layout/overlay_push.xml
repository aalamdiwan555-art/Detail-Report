<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:contentDescription="ULTRA detection overlay">

    <TextView
        android:id="@+id/tvPushLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_push_logo"
        android:gravity="center"
        android:padding="8dp"
        android:text="PUSH"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnCloseOverlay"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-10dp"
        android:layout_marginEnd="-10dp"
        android:background="@drawable/bg_close_btn"
        android:contentDescription="Stop detection"
        android:padding="7dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="@android:color/white" />
</FrameLayout>