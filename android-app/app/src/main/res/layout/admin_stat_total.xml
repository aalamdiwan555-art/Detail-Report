<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="82dp" android:layout_weight="1"
    android:layout_marginEnd="4dp" android:orientation="vertical"
    android:background="@drawable/bg_glass_card" android:padding="12dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TOTAL" android:textColor="@color/muted" android:textSize="10sp" />
    <TextView android:id="@+id/stat_total" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:text="0" android:textColor="@color/primary" android:textSize="24sp"
        android:textStyle="bold" />
</LinearLayout>