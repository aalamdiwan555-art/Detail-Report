<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- SECRET ADMIN GESTURE TARGET - 200x100 for easy 6 sec hold -->
            <FrameLayout
                android:id="@+id/logo_access_target"
                android:layout_width="200dp"
                android:layout_height="100dp"
                android:layout_marginTop="44dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="ULTRA logo">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/logo_mark"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@null"
                        android:src="@drawable/logo_mark" />

                    <TextView
                        android:id="@+id/logo_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="ULTRA"
                        android:textColor="#00FF88"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.4" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ultra AutoDetector"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Private detection. No cloud. No keys."
                android:textColor="#888888"
                android:textSize="14sp" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="36dp"
                app:tabIndicatorColor="#00FF88"
                app:tabIndicatorHeight="3dp"
                app:tabSelectedTextColor="#00FF88"
                app:tabTextColor="#888888"
                app:tabMode="fixed"
                app:tabGravity="fill">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOGIN" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIGN UP" />
            </com.google.android.material.tabs.TabLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Email address"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="#1A1A1A"
                app:boxStrokeColor="#00FF88"
                app:boxStrokeWidth="1dp"
                app:hintTextColor="#AAAAAA"
                app:startIconDrawable="@android:drawable/ic_dialog_email"
                app:startIconTint="#555555">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@android:color/transparent"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Password"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="#1A1A1A"
                app:boxStrokeColor="#00FF88"
                app:boxStrokeWidth="1dp"
                app:hintTextColor="#AAAAAA"
                app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                app:startIconTint="#555555"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="#555555">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@android:color/transparent"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="LOGIN"
                android:textColor="#000000"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:cornerRadius="28dp"
                android:backgroundTint="#00FF88" />

            <ProgressBar
                android:id="@+id/auth_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="-40dp"
                android:layout_marginBottom="16dp"
                android:indeterminateTint="#000000"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
